# Строка подключения к PostgreSQL 14+. Можно и в виде postgresql://… (как выдают Neon, Render) — драйвер подставится сам
DATABASE_URL=postgresql+psycopg://bja:bja@localhost:5432/bja
# Секрет для подписи токенов — в продакшене длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Срок действия токена, часов
TOKEN_TTL=24
# Часовой пояс для проверки «дата записи не позже сегодня»
APP_TIMEZONE=Europe/Moscow
# Адреса сайта для CORS через запятую (пусто — сайт и API на одном адресе)
CORS_ORIGINS=
# Папка фронтенда: бэкенд отдаст сайт на http://localhost:8000 (для разработки; в продакшене сайт отдаёт nginx)
FRONTEND_DIR=../frontend
# Необязательно: LOG_DIR (по умолчанию backend/logs), MAINTENANCE_FILE (по умолчанию backend/maintenance.on), LOG_LEVEL
# Для тестов: TEST_DATABASE_URL (по умолчанию bja_test на localhost)
